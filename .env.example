# Copy to .env for local runs (.env is gitignored). In GitHub, add these as
# repository Secrets (Settings → Secrets and variables → Actions).
# Every key is optional: a module whose key is missing is skipped and the
# briefing says so.

# --- LLM that writes the briefing (pick one; first configured wins) --------
LLM_PROVIDER=            # anthropic | openai | gemini
LLM_MODEL=               # optional override
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- ai-visibility-geo: engines to test (uses the keys above + Perplexity) --
PERPLEXITY_API_KEY=
GEO_OPENAI_MODEL=gpt-4.1
GEO_GEMINI_MODEL=gemini-2.5-flash
GEO_PERPLEXITY_MODEL=sonar
GEO_CLAUDE_MODEL=claude-sonnet-5-5

# --- seo-hunter -----------------------------------------------------------
# Service-account JSON (one line) with read access to the Search Console property
GSC_SERVICE_ACCOUNT_JSON_BOYER=

# --- viral-radar ----------------------------------------------------------
YOUTUBE_API_KEY=
# Optional, off by default (see README → Data sources & terms)
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=      # e.g. an Apify TikTok hashtag actor id
APIFY_INSTAGRAM_ACTOR=

# --- competitor-spy -------------------------------------------------------
GOOGLE_PLACES_API_KEY=
META_AD_LIBRARY_TOKEN=   # EU/UK ad data only

# --- delivery (one set per brand) ------------------------------------------
SLACK_WEBHOOK_URL_BOYER=
BRIEFING_EMAIL_TO_BOYER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
